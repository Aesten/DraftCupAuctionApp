<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AuctionApp.ViewModels"
                    xmlns:views="clr-namespace:AuctionApp.Views">

    <!-- Which view shows which page. -->

    <DataTemplate DataType="{x:Type vm:TournamentViewModel}">
        <views:TournamentView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PoolViewModel}">
        <views:PoolView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DivisionViewModel}">
        <views:DivisionView />
    </DataTemplate>

</ResourceDictionary>
