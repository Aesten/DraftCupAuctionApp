<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the app compile on Linux/macOS too (CI, cloud editors). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AuctionApp</RootNamespace>
    <AssemblyName>DraftCupAuctionApp</AssemblyName>
    <Product>Draft Cup Auction</Product>
    <Version>3.1.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Release builds: one small .exe (under 1 MB) that uses the .NET Desktop Runtime installed on the PC. When it's
    missing, the exe itself shows a Windows dialog offering to download it (a one-time install per PC).
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Also runs on a newer major version (e.g. .NET 11) if that's the only one installed. -->
    <RollForward>Major</RollForward>
    <!-- The app is in English: leave out the translated resources of the libraries it uses. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuctionApp.Core\AuctionApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Classes\*.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
