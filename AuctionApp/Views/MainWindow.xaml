<Window x:Class="AuctionApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AuctionApp.Controls"
        xmlns:vm="clr-namespace:AuctionApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Draft Cup Auction"
        Width="1600"
        Height="920"
        MinWidth="1100"
        MinHeight="640"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- A known tournament, in the start page and the menu -->
        <DataTemplate x:Key="RecentItem" DataType="{x:Type vm:TournamentListItem}">
            <Button Margin="0,0,0,4" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" Style="{StaticResource SubtleButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Marker" Width="3" Margin="0,2,10,2" CornerRadius="1.5" Background="Transparent" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Strong}" Text="{Binding Title}" />
                            <Ellipse x:Name="Live" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource SystemFillColorSuccessBrush}" ToolTip="Auction in progress" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="{Binding Details, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding EditedText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="Marker" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Live" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A large action button on the start page: icon, title and one line of explanation. -->
        <Style x:Key="StartTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="MenuHeading" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,16,0,6" />
        </Style>

        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The open tournament -->
        <ContentControl Content="{Binding Current}" Focusable="False" />

        <!-- Start page: no tournament open. A centered welcome layout: actions on the left, known tournaments on the right. -->
        <Grid Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid MaxWidth="980" Margin="48,32" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,40" Orientation="Horizontal">
                    <Image Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/app.png" />
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="32" Style="{StaticResource PageTitle}" Text="Draft Cup Auction" />
                        <TextBlock Margin="0,2,0,0" FontSize="15" Style="{StaticResource Caption}" Text="Player auctions for draft cups, run on stream." />
                    </StackPanel>
                </StackPanel>

                <!-- Get started -->
                <StackPanel Grid.Row="1">
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Overline}" Text="GET STARTED" />
                    <Button Command="{Binding NewTournamentCommand}" Style="{StaticResource StartTile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE710;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="15" Style="{StaticResource Strong}" Text="New tournament" />
                                <TextBlock Style="{StaticResource Caption}" Text="An empty player pool and a first division" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Margin="0,8,0,0" Command="{Binding ImportCommand}" Style="{StaticResource StartTile}"
                            ToolTip="You can also drop the file on the window, or open it with the app">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE8B5;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="15" Style="{StaticResource Strong}" Text="Import a tournament…" />
                                <TextBlock Style="{StaticResource Caption}" Text="A .draftcup.json file exported on this PC or another one" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SubtleButton}" ToolTip="{Binding DataFolder}">
                        <controls:IconLabel Glyph="&#xE8B7;" Text="Open the data folder" />
                    </Button>
                </StackPanel>

                <!-- Known tournaments -->
                <DockPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource Overline}" Text="TOURNAMENTS ON THIS PC" />
                    <Border Padding="24,20" VerticalAlignment="Top" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="15" Style="{StaticResource Strong}" Text="No tournaments yet" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Tournaments you create or import show up here. They're saved automatically after every change." />
                        </StackPanel>
                    </Border>
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl Margin="-12,0,0,0" Focusable="False" ItemTemplate="{StaticResource RecentItem}" ItemsSource="{Binding Recent}" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Floating menu: over the page, never pushing it -->
        <Grid Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#66000000">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding ToggleMenuCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
            </Border>
            <Border Width="340" HorizontalAlignment="Left"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,12,12,12">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="28" Height="28" Margin="8,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/app.png" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" Style="{StaticResource Strong}" Text="Draft Cup Auction" />
                        <Button Grid.Column="2" Command="{Binding ToggleMenuCommand}" Style="{StaticResource SubtleButton}" ToolTip="Close the menu (Esc)">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top">
                        <!-- The open tournament -->
                        <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MenuHeading}" Text="THIS TOURNAMENT" />
                            <TextBlock Margin="12,0,0,6" FontSize="15" Style="{StaticResource Strong}" Text="{Binding Current.Title}" />
                            <Button Command="{Binding Current.ExportCommand}" Style="{StaticResource MenuButton}"
                                    ToolTip="Save the whole tournament to a file, to run a division on another PC. Import it back afterwards to merge the results.">
                                <controls:IconLabel Glyph="&#xEDE1;" Text="Export the tournament…" />
                            </Button>
                            <Button Command="{Binding Current.DuplicateCommand}" Style="{StaticResource MenuButton}"
                                    ToolTip="New tournament with the same pool and divisions, without any auction results">
                                <controls:IconLabel Glyph="&#xE8C8;" Text="Duplicate for a new event" />
                            </Button>
                            <Button Command="{Binding CloseTournamentCommand}" Style="{StaticResource MenuButton}">
                                <controls:IconLabel Glyph="&#xE8BB;" Text="Close" />
                            </Button>
                            <Button Command="{Binding Current.DeleteCommand}" Style="{StaticResource MenuButton}" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                <controls:IconLabel Glyph="&#xE74D;" Text="Delete…" />
                            </Button>
                        </StackPanel>

                        <TextBlock Style="{StaticResource MenuHeading}" Text="TOURNAMENTS" />
                        <Button Command="{Binding NewTournamentCommand}" Style="{StaticResource MenuButton}">
                            <controls:IconLabel Glyph="&#xE710;" Text="New tournament" />
                        </Button>
                        <Button Command="{Binding ImportCommand}" Style="{StaticResource MenuButton}"
                                ToolTip="A tournament exported from this app (.draftcup.json), on this PC or another one. You can also drop the file on the window.">
                            <controls:IconLabel Glyph="&#xE8B5;" Text="Import a tournament…" />
                        </Button>
                        <TextBlock Style="{StaticResource MenuHeading}" Text="ON THIS PC" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Command="{Binding OpenDataFolderCommand}" Style="{StaticResource MenuButton}" ToolTip="{Binding DataFolder}">
                            <controls:IconLabel Glyph="&#xE8B7;" Text="Open the data folder" />
                        </Button>
                        <TextBlock Margin="12,6,0,0" Style="{StaticResource Caption}" Text="F11: full screen" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource RecentItem}" ItemsSource="{Binding Recent}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
