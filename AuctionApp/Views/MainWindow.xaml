<Window x:Class="AuctionApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AuctionApp.Controls"
        xmlns:vm="clr-namespace:AuctionApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Draft Cup Auction"
        Width="1480"
        Height="920"
        MinWidth="1000"
        MinHeight="640"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: the library of tournaments -->
        <Border Width="260"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="12,16,12,12">
                <Grid DockPanel.Dock="Top" Margin="4,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" Source="/Assets/app.ico" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" Style="{StaticResource Strong}" Text="Draft Cup" />
                        <TextBlock Style="{StaticResource Caption}" Text="AUCTION" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding ToggleSidebarCommand}" Style="{StaticResource SubtleButton}" ToolTip="Hide the sidebar">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" />
                    </Button>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" FontWeight="SemiBold" Text="TOURNAMENTS" />
                    <Button HorizontalAlignment="Right" Command="{Binding NewTournamentCommand}" Style="{StaticResource SubtleButton}" ToolTip="Create a tournament">
                        <controls:IconLabel Glyph="&#xE710;" Text="New" />
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Command="{Binding ImportCommand}" Style="{StaticResource SubtleButton}"
                            ToolTip="Open a tournament file: one exported from this app (from another PC too), or a .json file from the old version. You can also drop files on the window.">
                        <controls:IconLabel Glyph="&#xE8B5;" Text="Import a file…" />
                    </Button>
                    <Button Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SubtleButton}" ToolTip="{Binding DataFolder}">
                        <controls:IconLabel Glyph="&#xE8B7;" Text="Open the data folder" />
                    </Button>
                    <TextBlock Margin="6,8,0,0" Style="{StaticResource Caption}" Text="F11: stream mode" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TournamentListItem}">
                            <StackPanel Margin="0,4">
                                <TextBlock Style="{StaticResource Strong}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The open tournament -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Current}" Focusable="False" />

            <!-- Nothing open -->
            <Border MaxWidth="560" Margin="0,80,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                    Visibility="{Binding Current, Converter={StaticResource EmptyToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="64" Height="64" Source="/Assets/app.ico" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Welcome to Draft Cup Auction" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                               Text="A tournament holds a player pool and one or more divisions, each with its own captains and auction. Create one, or import a tournament file (or a .json file from the old version)." />
                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Command="{Binding ImportCommand}" Content="Import a file…" />
                        <Button Margin="8,0,0,0" Command="{Binding NewTournamentCommand}" Content="New tournament" Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding ToggleSidebarCommand}"
                    Style="{StaticResource SubtleButton}" ToolTip="Show the sidebar"
                    Visibility="{Binding ShowSidebarButton, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="16" Style="{StaticResource Glyph}" Text="&#xE700;" />
            </Button>
        </Grid>
    </Grid>
</Window>
