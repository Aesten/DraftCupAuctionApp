<Window x:Class="AuctionApp.Views.PlayerPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AuctionApp.Controls"
        xmlns:services="clr-namespace:AuctionApp.Services"
        Width="480"
        Height="600"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <Grid Margin="0,12,0,0">
                <TextBox x:Name="SearchBox" Padding="32,5,10,6" VerticalContentAlignment="Center" PreviewKeyDown="SearchBox_PreviewKeyDown" TextChanged="SearchBox_TextChanged" />
                <TextBlock Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource Glyph}" Text="&#xE721;" />
                <TextBlock x:Name="SearchHint" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Search players" />
            </Grid>
        </StackPanel>

        <ListBox x:Name="PlayersList" Grid.Row="1" Margin="12,0,12,8" HorizontalContentAlignment="Stretch" MouseDoubleClick="PlayersList_MouseDoubleClick" SelectionChanged="PlayersList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type services:PlayerChoice}">
                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="15" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <controls:ClassIconStrip Grid.Column="1" Margin="8,0" IconSize="22" ItemsSource="{Binding Classes}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Where}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="24,16"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" MinWidth="96" Click="Ok_Click" Content="Swap" IsDefault="True" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" />
                <Button MinWidth="96" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
