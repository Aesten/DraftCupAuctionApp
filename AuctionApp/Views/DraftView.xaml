<UserControl x:Class="AuctionApp.Views.DraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AuctionApp.Views"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DraftViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Margin="16,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding GoBackCommand}" Padding="10" Style="{StaticResource SubtleButton}" ToolTip="Back to all drafts">
                <TextBlock FontSize="16" Style="{StaticResource Glyph}" Text="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontSize="22" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <Border Margin="12,0,0,0" Style="{StaticResource Pill}">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StatusText}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Save problems must never go unnoticed. -->
        <Border Grid.Row="1" Margin="24,12,24,0" Padding="12,8" CornerRadius="4"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding SaveError, Converter={StaticResource NotEmptyToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Style="{StaticResource Glyph}" Text="&#xEA39;" />
                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SaveError}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="16,8,16,0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Setup">
                <views:SetupView DataContext="{Binding Setup}" />
            </TabItem>
            <TabItem Header="Auction">
                <views:AuctionView DataContext="{Binding Auction}" />
            </TabItem>
            <TabItem Header="Results">
                <views:ResultsView DataContext="{Binding Results}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
