<UserControl x:Class="AuctionApp.Views.TournamentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:TournamentViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One compact bar, so the auction gets almost the whole window -->
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,6,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Margin="0,0,0,6" Padding="10" VerticalAlignment="Center"
                        Command="{Binding DataContext.ToggleMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SubtleButton}" ToolTip="Menu: tournaments, import, export">
                    <TextBlock FontSize="16" Style="{StaticResource Glyph}" Text="&#xE700;" />
                </Button>

                <!-- The title is edited in place -->
                <TextBox Grid.Column="1" MinWidth="120" MaxWidth="360" Margin="4,0,12,6" Padding="4,2" VerticalAlignment="Center"
                         Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tournament name (click to rename)" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Style="{StaticResource TabStrip}">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type vm:PoolViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE716;" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Header}" />
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DivisionViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Header}" />
                                    <Ellipse x:Name="Live" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource SystemFillColorSuccessBrush}" ToolTip="Auction in progress" Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter TargetName="Live" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <Button Margin="2,0,0,6" VerticalAlignment="Center" Command="{Binding AddDivisionCommand}" Style="{StaticResource SubtleButton}"
                            ToolTip="Add a division (another auction sharing the same player pool)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                    </Button>
                </StackPanel>

                <!-- The selected division's pages -->
                <ListBox Grid.Column="3" Margin="0,0,0,6" VerticalAlignment="Center"
                         SelectedIndex="{Binding SelectedDivision.SelectedPage}" Style="{StaticResource SegmentedList}"
                         Visibility="{Binding SelectedDivision, Converter={StaticResource NotEmptyToVisibility}}">
                    <ListBoxItem>
                        <controls:IconLabel Glyph="&#xE713;" Text="Configure" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <controls:IconLabel Glyph="&#xE7C1;" Text="Auction" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <controls:IconLabel Glyph="&#xE902;" Text="Teams" />
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- Save problems must never go unnoticed. -->
        <Border Grid.Row="1" Margin="16,8,16,0" Padding="12,8" CornerRadius="4"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding SaveError, Converter={StaticResource NotEmptyToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Style="{StaticResource Glyph}" Text="&#xEA39;" />
                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SaveError}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding SelectedTab}" Focusable="False" />
    </Grid>
</UserControl>
