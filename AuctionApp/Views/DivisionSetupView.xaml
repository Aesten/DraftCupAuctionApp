<UserControl x:Class="AuctionApp.Views.DivisionSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:engine="clr-namespace:AuctionApp.Core.Engine;assembly=AuctionApp.Core"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DivisionSetupViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <UserControl.Resources>
        <controls:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <!-- Red border for text boxes holding something that isn't a valid number. -->
        <Style x:Key="ErrorBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Shown once the auction has started -->
        <Border Margin="0,0,0,16" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE72E;" />
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Style="{StaticResource Strong}" Text="The auction has started, so this division's settings are locked." />
                    <TextBlock Style="{StaticResource Caption}" Text="Captains' classes can still be changed. To change captains, budgets or the team size, reset the auction. That clears every sale in this division." />
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ResetAuctionCommand}">
                    <controls:IconLabel Glyph="&#xE72C;" Text="Reset auction…" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="460" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Padding="0,0,4,0" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsEditable}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Division" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Players per team (plus the captain)" />
                            <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{Binding TeamSizeOptions}" SelectedItem="{Binding TeamSize}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Auction" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Order of the players" />
                            <RadioButton Content="Random, shuffled when the auction starts" GroupName="Order" IsChecked="{Binding ShuffleOrder}" />
                            <RadioButton Content="The order of the player pool" GroupName="Order" IsChecked="{Binding PoolOrder}" />
                            <Button Margin="28,0,0,0" Command="{Binding ShowPoolCommand}" Style="{StaticResource SubtleButton}"
                                    Visibility="{Binding PoolOrder, Converter={StaticResource BoolToVisibility}}">
                                <controls:IconLabel Glyph="&#xE8CB;" Text="Arrange the order in the player pool" />
                            </Button>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Upcoming players shown on screen" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="80" ItemsSource="{Binding UpcomingOptions}" SelectedItem="{Binding UpcomingShown}" />
                                <TextBlock Margin="12,0,0,0" MaxWidth="260" VerticalAlignment="Center" Style="{StaticResource Caption}"
                                           Text="The rest of the queue stays hidden, so captains can't plan too far ahead." />
                            </StackPanel>

                            <CheckBox Margin="0,16,0,0" Content="Half budget cap on when the auction starts" IsChecked="{Binding HalfBudgetCapAtStart}" />
                            <TextBlock Margin="28,0,0,0" Style="{StaticResource Caption}"
                                       Text="Captains can only spend down to half of their budget until it is turned off during the auction." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Captains -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding CaptainsHeader}" />
                        <Button HorizontalAlignment="Right" Command="{Binding AddCaptainCommand}" IsEnabled="{Binding IsEditable}">
                            <controls:IconLabel Glyph="&#xE710;" Text="Add captain" />
                        </Button>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Style="{StaticResource Caption}"
                               Text="Each captain leads a team, with the class they signed up with and their own budget (in millions), balanced against their skill. The order here is the order of the team cards." />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="Name" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Caption}" Text="Class" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Caption}" Text="Budget" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Captains' classes stay editable during the auction; the rest is locked. -->
                        <ItemsControl Margin="0,0,8,0" Focusable="False" ItemsSource="{Binding Captains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CaptainRowViewModel}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}" Loaded="CaptainName_Loaded"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="The class the captain signed up with">
                                            <ToggleButton IsChecked="{Binding IsInfantry}" Style="{StaticResource ClassToggle}" Tag="inf" />
                                            <ToggleButton IsChecked="{Binding IsArcher}" Style="{StaticResource ClassToggle}" Tag="arc" />
                                            <ToggleButton IsChecked="{Binding IsCavalry}" Style="{StaticResource ClassToggle}" Tag="cav" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Margin="8,0,0,0" IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}"
                                                Style="{StaticResource ErrorBorder}" Tag="{Binding HasBudgetError}">
                                            <TextBox HorizontalContentAlignment="Right" Text="{Binding BudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Border>
                                        <StackPanel Grid.Column="3" Margin="4,0,0,0" IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}" Orientation="Horizontal">
                                            <Button Command="{Binding Data.MoveCaptainUpCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                    Style="{StaticResource SubtleButton}" ToolTip="Move up">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" />
                                            </Button>
                                            <Button Command="{Binding Data.MoveCaptainDownCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                    Style="{StaticResource SubtleButton}" ToolTip="Move down">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" />
                                            </Button>
                                            <Button Command="{Binding Data.RemoveCaptainCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}" ToolTip="Remove this captain">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer: players available, what still needs fixing, and the way into the auction -->
        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Strong}" Text="{Binding Summary}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding AvailabilityText}" />
                    <ItemsControl Margin="0,4,0,0" Focusable="False" ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type engine:ValidationIssue}">
                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Foreground="{DynamicResource SystemFillColorCautionBrush}" Style="{StaticResource Glyph}" Text="&#xE7BA;" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding DeleteDivisionCommand}" Style="{StaticResource DangerButton}" ToolTip="Delete this division">
                    <controls:IconLabel Glyph="&#xE74D;" Text="Delete division" />
                </Button>
                <Button Grid.Column="2" MinWidth="180" Padding="20,10" VerticalAlignment="Center"
                        Command="{Binding StartAuctionCommand}"
                        IsEnabled="{Binding CanStart}"
                        Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}">
                    <controls:IconLabel Glyph="&#xE768;" Text="Start auction" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
