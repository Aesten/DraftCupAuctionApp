<UserControl x:Class="AuctionApp.Views.AuctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AuctionViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1900"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             IsTabStop="False"
             mc:Ignorable="d">
    <!--
        Designed to be screen-shared: everything viewers need is on screen at once (the player on the block, the next
        few players, every team with its budget and roster), with no scrolling and nothing they shouldn't see.
        Top: the auctioneer's controls, the player on the block (center stage) and the next players. Below: the rosters.
        The bidding team is selected by clicking its card; a bought player can be clicked to fix the sale.
    -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding SellCommand}" Gesture="Ctrl+Enter" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="BigAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- Captain Pick: players left of one class in a tier (framed class icon + number) -->
        <DataTemplate x:Key="BoardCount" DataType="{x:Type vm:ClassCount}">
            <StackPanel x:Name="Root" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="{Binding Code, Converter={StaticResource ClassName}}">
                <Border Width="20" Height="20" Padding="3" VerticalAlignment="Center"
                        Background="{Binding Code, Converter={StaticResource ClassBrush}, ConverterParameter=0.28}"
                        BorderBrush="{Binding Code, Converter={StaticResource ClassBrush}, ConverterParameter=0.9}"
                        BorderThickness="1" CornerRadius="4">
                    <Rectangle Fill="{DynamicResource TextFillColorPrimaryBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding Code, Converter={StaticResource ClassIcon}}" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Count}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsZero}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The menu of a bought player: fixing a sale without undoing everything after it. -->
        <ContextMenu x:Key="PickMenu" x:Shared="False">
            <MenuItem Header="{Binding Header}" IsEnabled="False" />
            <Separator />
            <MenuItem Command="{Binding ReturnToBlockCommand}" Header="Refund and put back on the block" IsEnabled="{Binding CanReturn}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ReturnToSkippedCommand}" Header="{Binding ReturnToListText}" IsEnabled="{Binding CanReturn}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding ChangePriceCommand}" Header="Change the price…">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Move to another team" ItemsSource="{Binding OtherTeams}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" />
                </MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding DataContext.MoveToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Command="{Binding SwapCommand}" Header="Swap with another player…">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="TeamCardTemplate" DataType="{x:Type vm:TeamCardViewModel}">
            <Border x:Name="Card"
                    Padding="14,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    ToolTip="Click to select this team as the one bidding">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ClassIconStrip Margin="0,0,5,0" IconSize="22" ItemsSource="{Binding CaptainClasses}" />
                        <TextBlock x:Name="TeamName" Grid.Column="1" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Strong}"
                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding BudgetText}" ToolTip="{Binding BudgetToolTip}" />
                    </Grid>

                    <!-- Budget: 0 on the left, the starting budget on the right; the reserved half is hatched while the cap is on -->
                    <controls:BudgetBar DockPanel.Dock="Top" Height="8" Margin="0,6,0,2"
                                        Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                        Hatch="{DynamicResource AccentFillColorDefaultBrush}"
                                        Maximum="{Binding InitialBudget}"
                                        Reserved="{Binding Reserved}"
                                        ShowReserved="{Binding IsCapped}"
                                        ToolTip="{Binding BudgetToolTip}"
                                        Track="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                        Value="{Binding Remaining}" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock FontSize="11" Style="{StaticResource Caption}" Text="0" />
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Style="{StaticResource Caption}" Text="{Binding InitialBudgetText}" />
                    </Grid>

                    <!-- Bottom: players of each class (captain included), and how full the team is -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Composition}" Style="{StaticResource ClassCounts}" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SlotsText}" ToolTip="Players bought / team size" />
                    </Grid>

                    <StackPanel>
                        <ItemsControl Focusable="False" ItemsSource="{Binding Picks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PickItemViewModel}">
                                    <Border x:Name="Row" Height="27" Margin="-4,0" Padding="4,0" Background="Transparent" CornerRadius="4"
                                            ContextMenu="{StaticResource PickMenu}" MouseLeftButtonDown="PickRow_MouseLeftButtonDown"
                                            ToolTip="Click to fix this sale">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="20" ItemsSource="{Binding Classes}" />
                                            <TextBlock Grid.Column="2" MinWidth="36" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PriceText}" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Focusable="False" ItemsSource="{Binding EmptySlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="21" Margin="0,3" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanBuy}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Padding" Value="13,11" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="TeamName" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,16">
        <!-- Before the auction starts -->
        <Border MaxWidth="560" Margin="0,48,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE768;" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="The auction hasn't started yet" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="Set up the captains on the Configure page, then click Start auction at the bottom of it." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The auctioneer's controls -->
                <Border Padding="16" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" Click="SkippedButton_Click" IsEnabled="{Binding IsRunning}"
                                    ToolTip="See every skipped player and put one back on the block"
                                    Visibility="{Binding IsRandomPick, Converter={StaticResource BoolToVisibility}}">
                                <controls:IconLabel Glyph="&#xE8FD;" Text="{Binding SkippedCount, StringFormat='Skipped players ({0})'}" />
                            </Button>
                            <Button HorizontalAlignment="Stretch" Click="BoardButton_Click" IsEnabled="{Binding IsRunning}"
                                    ToolTip="Open the pick board: every player still available, by tier and class. Click the player a captain picks."
                                    Visibility="{Binding IsCaptainPick, Converter={StaticResource BoolToVisibility}}">
                                <controls:IconLabel Glyph="&#xE80A;" Text="{Binding BoardCount, StringFormat='Pick board ({0})'}" />
                            </Button>
                            <Button x:Name="MoreButton" Grid.Column="2" Click="MoreButton_Click" ToolTip="Half budget cap, undo, finish the auction">
                                <controls:IconLabel Glyph="&#xE712;" Text="More" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Half budget cap" IsCheckable="True" IsChecked="{Binding HalfBudgetCap}" IsEnabled="{Binding IsRunning}"
                                                  ToolTip="While on, captains can only spend down to half of their starting budget." />
                                        <Separator />
                                        <MenuItem Command="{Binding UndoCommand}" Header="{Binding UndoText}" InputGestureText="Ctrl+Z">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding FinishCommand}" Header="Finish the auction…" IsEnabled="{Binding IsRunning}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C1;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <Grid>
                            <!-- Selling the player on the block -->
                            <!-- The three states share one cell and are hidden rather than collapsed: the top band never changes height. -->
                            <StackPanel VerticalAlignment="Top" Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToHidden}}">
                                <Border x:Name="WinnerBox" Height="48" Padding="12,0" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Click the bidding team"
                                                   Visibility="{Binding SelectedTeam, Converter={StaticResource EmptyToVisibility}}" />
                                        <TextBlock FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Strong}"
                                                   Text="{Binding SelectedTeam.Name}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SelectedTeam, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </Grid>
                                </Border>
                                <!-- The price: typed, −/+, Up/Down, or the mouse wheel anywhere over this row -->
                                <Grid Margin="0,8,0,0" Background="Transparent" PreviewMouseWheel="PriceRow_PreviewMouseWheel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Width="44" Height="44" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" Content="−" FontSize="18" ToolTip="−0.1 (Down arrow, or scroll down)" />
                                    <TextBox x:Name="PriceBox" Grid.Column="1" Margin="6,0" Style="{StaticResource NumericTextBox}" FontSize="24" FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center" LostKeyboardFocus="PriceBox_LostKeyboardFocus"
                                             Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Price in millions&#x0a;Scroll or Up/Down: ±0.1  ·  Ctrl+scroll: ±1.0&#x0a;Enter: confirm the price  ·  Ctrl+Enter: sell">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Up" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" />
                                            <KeyBinding Key="Down" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <RepeatButton Grid.Column="2" Width="44" Height="44" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" Content="+" FontSize="18" ToolTip="+0.1 (Up arrow, or scroll up)" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SoldButton" Command="{Binding SellCommand}" Style="{StaticResource BigAccentButton}" ToolTip="Sell to the selected team (Ctrl+Enter)">
                                        <controls:IconLabel Glyph="&#xE8FB;" Text="Sold!" />
                                    </Button>

                                    <!-- Why a sale can't go through; going over a budget limit can be confirmed anyway -->
                                    <Popup AllowsTransparency="True" IsOpen="{Binding IsSaleWarningOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=SoldButton}"
                                           PopupAnimation="Fade" StaysOpen="False" VerticalOffset="6">
                                        <Border Width="320" Margin="0,0,8,8" Padding="16,14"
                                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" Style="{StaticResource Glyph}" Text="&#xE7BA;" />
                                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Strong}" Text="Can't sell as is" />
                                                </StackPanel>
                                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SaleWarning}" TextWrapping="Wrap" />
                                                <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Margin="0,0,8,0" Command="{Binding SellAnywayCommand}" Content="Sell anyway" Style="{DynamicResource AccentButtonStyle}"
                                                            Visibility="{Binding CanSellAnyway, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button MinWidth="80" Command="{Binding DismissSaleWarningCommand}" Content="Cancel" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Button Grid.Column="2" Command="{Binding SkipCommand}" Style="{StaticResource BigButton}" ToolTip="Nobody bids: move to the skipped list"
                                            Visibility="{Binding IsRandomPick, Converter={StaticResource BoolToVisibility}}">
                                        <controls:IconLabel Glyph="&#xE893;" Text="Skip" />
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding ReturnToBoardCommand}" Style="{StaticResource BigButton}" ToolTip="Picked by mistake: back on the pick board, no sale"
                                            Visibility="{Binding IsCaptainPick, Converter={StaticResource BoolToVisibility}}">
                                        <controls:IconLabel Glyph="&#xE7A7;" Text="Put back" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Nobody on the block -->
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToHidden}}">
                                <Button Command="{Binding RequeueSkippedCommand}" Style="{StaticResource BigAccentButton}"
                                        Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                                    <controls:IconLabel Glyph="&#xE72C;" Text="Auction the skipped players again" />
                                </Button>
                                <Button Click="BoardButton_Click" Style="{StaticResource BigAccentButton}" ToolTip="Click the player a captain picks to put them on the block"
                                        Visibility="{Binding ShowsBoardButton, Converter={StaticResource BoolToVisibility}}">
                                    <controls:IconLabel Glyph="&#xE80A;" Text="Open the pick board" />
                                </Button>
                                <Button Margin="0,8,0,0" Command="{Binding FinishCommand}" Style="{StaticResource BigButton}">
                                    <controls:IconLabel Glyph="&#xE7C1;" Text="Finish the auction" />
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsFinished, Converter={StaticResource BoolToHidden}}">
                                <Button Command="{Binding ShowTeamsCommand}" Style="{StaticResource BigAccentButton}">
                                    <controls:IconLabel Glyph="&#xE902;" Text="Team compositions" />
                                </Button>
                                <Button Margin="0,8,0,0" Command="{Binding ReopenCommand}" Style="{StaticResource BigButton}"
                                        ToolTip="Continue the auction; unsold players come back">
                                    <controls:IconLabel Glyph="&#xE72C;" Text="Reopen the auction" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Center stage: the player on the block -->
                <Border Grid.Column="2" MinHeight="200" Padding="20,14" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run FontWeight="SemiBold" Text="{Binding SoldCount, Mode=OneWay}" /><Run Text=" sold  ·  " /><Run FontWeight="SemiBold" Text="{Binding RemainingCount, Mode=OneWay}" /><Run Text="{Binding RemainingLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Overline}" Text="{Binding StageLabel}" />
                        <!-- Hidden rather than collapsed, so showing it never changes the card's layout -->
                        <Border HorizontalAlignment="Right" Style="{StaticResource Pill}" ToolTip="Captains can only spend down to half of their starting budget."
                                Visibility="{Binding HalfBudgetCap, Converter={StaticResource BoolToHidden}}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Half budget cap" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToHidden}}">
                            <Viewbox MaxHeight="84" HorizontalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CurrentPlayerName}" />
                            </Viewbox>
                            <!-- Classes, and in Captain Pick the tier and minimum bid on the same line (a fixed height, so nothing moves) -->
                            <StackPanel Height="44" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <controls:ClassIconStrip VerticalAlignment="Center" IconSize="44" ItemsSource="{Binding CurrentPlayerClasses}" />
                                <Border Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Pill}"
                                        Visibility="{Binding CurrentTierText, Converter={StaticResource NotEmptyToVisibility}}">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CurrentTierText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Style="{StaticResource SectionTitle}"
                                   Text="{Binding StageMessage}" TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding HasCurrentPlayer, Converter={StaticResource InverseBoolToHidden}}" />

                        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding LastAction}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LastAction}" />
                    </Grid>
                </Border>

                <!-- The next few players (the rest of the queue stays hidden), and the whole queue on demand, sorted by name -->
                <Grid Grid.Column="3" Width="300" Margin="12,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Margin="0,0,0,8" Padding="18,14" Style="{StaticResource Card}" Visibility="{Binding ShowsUpNext, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelLabel}" Text="{Binding UpNextHeader}" />
                            <Grid>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Nobody else in the queue."
                                           Visibility="{Binding UpNext.Count, Converter={StaticResource EmptyToVisibility}}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding UpNext}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="1" Rows="{Binding DataContext.UpNextRows, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                            <Grid MinHeight="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="18" Style="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="24" ItemsSource="{Binding Classes}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="RemainingButton_Click"
                            ToolTip="Everyone still in the queue, sorted by name so the auction order stays hidden (skipped players not included)"
                            Visibility="{Binding IsRandomPick, Converter={StaticResource BoolToVisibility}}">
                        <controls:IconLabel Glyph="&#xE8FD;" Text="{Binding RemainingCount, StringFormat='Remaining players ({0})'}" />
                    </Button>

                    <!-- Captain Pick: what's left on the pick board, per tier and class -->
                    <Border Grid.RowSpan="2" Padding="18,14" Style="{StaticResource Card}" Visibility="{Binding IsCaptainPick, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelLabel}" Text="ON THE BOARD" />
                            <ItemsControl VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding Board}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BoardTierViewModel}">
                                        <Grid x:Name="Row" Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource Strong}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <!-- One fixed column per class, so icons line up from one tier to the next -->
                                            <ContentControl Grid.Column="1" Content="{Binding Counts[0]}" ContentTemplate="{StaticResource BoardCount}" Focusable="False" />
                                            <ContentControl Grid.Column="2" Content="{Binding Counts[1]}" ContentTemplate="{StaticResource BoardCount}" Focusable="False" />
                                            <ContentControl Grid.Column="3" Content="{Binding Counts[2]}" ContentTemplate="{StaticResource BoardCount}" Focusable="False" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Count}" Value="0">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                </Grid>
            </Grid>

            <!-- Rosters: every team, always fully visible -->
            <controls:ScaleToFit Grid.Row="2" VerticalAlignment="Top" MaxScale="1.25" MinScale="0.5">
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource TeamCardTemplate}" ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FitGrid MinItemWidth="260" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </controls:ScaleToFit>
        </Grid>
    </Grid>
</UserControl>
