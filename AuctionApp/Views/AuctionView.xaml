<UserControl x:Class="AuctionApp.Views.AuctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AuctionViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1900"
             mc:Ignorable="d">
    <!--
        Designed to be screen-shared: everything viewers need is on screen at once (the player on the block, the next
        few players, every team with its budget and roster), with no scrolling and nothing they shouldn't see.
        Top: the auctioneer's controls, the player on the block (center stage) and the next players. Below: the rosters.
        The winning team is picked by clicking its card; a bought player can be clicked to fix the sale.
    -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="BigAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- The menu of a bought player: fixing a sale without undoing everything after it. -->
        <ContextMenu x:Key="PickMenu" x:Shared="False">
            <MenuItem Header="{Binding Header}" IsEnabled="False" />
            <Separator />
            <MenuItem Command="{Binding ReturnToBlockCommand}" Header="Refund and put back on the block" IsEnabled="{Binding CanReturn}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ReturnToSkippedCommand}" Header="Refund and send to the skipped list" IsEnabled="{Binding CanReturn}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding ChangePriceCommand}" Header="Change the price…">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Move to another team" ItemsSource="{Binding OtherTeams}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" />
                </MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding DataContext.MoveToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Command="{Binding SwapCommand}" Header="Swap with another player…">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="TeamCardTemplate" DataType="{x:Type vm:TeamCardViewModel}">
            <Border x:Name="Card"
                    Padding="14,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    ToolTip="Click to pick this team as the winner">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ClassIconStrip Margin="0,0,5,0" IconSize="22" ItemsSource="{Binding CaptainClasses}" />
                        <TextBlock x:Name="TeamName" Grid.Column="1" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Strong}"
                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding RemainingText}" />
                    </Grid>
                    <ProgressBar DockPanel.Dock="Top" Height="4" Margin="0,4,0,4" Maximum="1" Minimum="0" Value="{Binding BudgetLeftRatio, Mode=OneWay}" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock FontSize="13" Style="{StaticResource Caption}" Text="{Binding MaxBidText}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="13" Style="{StaticResource Caption}" Text="{Binding SlotsText}" />
                    </Grid>
                    <ItemsControl DockPanel.Dock="Bottom" Margin="0,8,0,0" ItemsSource="{Binding Composition}" Style="{StaticResource ClassCounts}" />

                    <StackPanel>
                        <ItemsControl Focusable="False" ItemsSource="{Binding Picks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PickItemViewModel}">
                                    <Border x:Name="Row" Height="27" Margin="-4,0" Padding="4,0" Background="Transparent" CornerRadius="4"
                                            ContextMenu="{StaticResource PickMenu}" MouseLeftButtonDown="PickRow_MouseLeftButtonDown"
                                            ToolTip="Click to fix this sale">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="20" ItemsSource="{Binding Classes}" />
                                            <TextBlock Grid.Column="2" MinWidth="36" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PriceText}" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Focusable="False" ItemsSource="{Binding EmptySlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="21" Margin="0,3" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanBuy}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Padding" Value="13,11" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="TeamName" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,16">
        <!-- Before the auction starts -->
        <Border MaxWidth="560" Margin="0,48,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE768;" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="The auction hasn't started yet" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="Set up the captains on the Configure page, then click Start auction at the bottom of it." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The auctioneer's controls -->
                <Border Padding="16" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" Click="SkippedButton_Click" IsEnabled="{Binding IsRunning}"
                                    ToolTip="See every skipped player and put one back on the block">
                                <controls:IconLabel Glyph="&#xE8FD;" Text="{Binding SkippedCount, StringFormat='Skipped players ({0})'}" />
                            </Button>
                            <Button x:Name="MoreButton" Grid.Column="2" Click="MoreButton_Click" ToolTip="Half budget cap, undo, finish the auction">
                                <controls:IconLabel Glyph="&#xE712;" Text="More" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Half budget cap" IsCheckable="True" IsChecked="{Binding HalfBudgetCap}" IsEnabled="{Binding IsRunning}"
                                                  ToolTip="While on, captains can only spend down to half of their starting budget." />
                                        <Separator />
                                        <MenuItem Command="{Binding UndoCommand}" Header="{Binding UndoText}" InputGestureText="Ctrl+Z">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding FinishCommand}" Header="Finish the auction…" IsEnabled="{Binding IsRunning}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C1;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <Grid>
                            <!-- Selling the player on the block -->
                            <StackPanel VerticalAlignment="Top" Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToVisibility}}">
                                <Border x:Name="WinnerBox" Height="48" Padding="12,0" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Click the winning team"
                                                   Visibility="{Binding SelectedTeam, Converter={StaticResource EmptyToVisibility}}" />
                                        <StackPanel Visibility="{Binding SelectedTeam, Converter={StaticResource NotEmptyToVisibility}}">
                                            <TextBlock FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Strong}"
                                                       Text="{Binding SelectedTeam.Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding SaleProblem}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SaleProblem}"
                                                       Visibility="{Binding SaleProblem, Converter={StaticResource NotEmptyToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Width="44" Height="44" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" Content="−" FontSize="18" ToolTip="−0.1 (Down arrow)" />
                                    <TextBox x:Name="PriceBox" Grid.Column="1" Margin="6,0" VerticalContentAlignment="Center" FontSize="24" FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Price in millions. Enter sells, Up/Down change it by 0.1.">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SellCommand}" />
                                            <KeyBinding Key="Up" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" />
                                            <KeyBinding Key="Down" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <RepeatButton Grid.Column="2" Width="44" Height="44" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" Content="+" FontSize="18" ToolTip="+0.1 (Up arrow)" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding SellCommand}" Style="{StaticResource BigAccentButton}" ToolTip="Sell to the selected team (Enter)">
                                        <controls:IconLabel Glyph="&#xE8FB;" Text="Sold!" />
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding SkipCommand}" Style="{StaticResource BigButton}" ToolTip="Nobody bids: move to the skipped list">
                                        <controls:IconLabel Glyph="&#xE893;" Text="Skip" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Nobody on the block -->
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibility}}">
                                <Button Command="{Binding RequeueSkippedCommand}" Style="{StaticResource BigAccentButton}"
                                        Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                                    <controls:IconLabel Glyph="&#xE72C;" Text="Auction the skipped players again" />
                                </Button>
                                <Button Margin="0,8,0,0" Command="{Binding FinishCommand}" Style="{StaticResource BigButton}">
                                    <controls:IconLabel Glyph="&#xE7C1;" Text="Finish the auction" />
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                                <Button Command="{Binding ShowTeamsCommand}" Style="{StaticResource BigAccentButton}">
                                    <controls:IconLabel Glyph="&#xE902;" Text="Team compositions" />
                                </Button>
                                <Button Margin="0,8,0,0" Command="{Binding ReopenCommand}" Style="{StaticResource BigButton}"
                                        ToolTip="Continue the auction; unsold players go back to the skipped list">
                                    <controls:IconLabel Glyph="&#xE72C;" Text="Reopen the auction" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Center stage: the player on the block -->
                <Border Grid.Column="2" MinHeight="200" Padding="20,14" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run FontWeight="SemiBold" Text="{Binding SoldCount, Mode=OneWay}" /><Run Text=" sold  ·  " /><Run FontWeight="SemiBold" Text="{Binding RemainingCount, Mode=OneWay}" /><Run Text=" in the queue" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Overline}" Text="{Binding StageLabel}" />
                        <Border HorizontalAlignment="Right" Style="{StaticResource Pill}" ToolTip="Captains can only spend down to half of their starting budget."
                                Visibility="{Binding HalfBudgetCap, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Half budget cap" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToVisibility}}">
                            <Viewbox MaxHeight="84" HorizontalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CurrentPlayerName}" />
                            </Viewbox>
                            <controls:ClassIconStrip Margin="0,10,0,0" HorizontalAlignment="Center" IconSize="44" ItemsSource="{Binding CurrentPlayerClasses}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Style="{StaticResource SectionTitle}"
                                   Text="{Binding StageMessage}" TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding HasCurrentPlayer, Converter={StaticResource InverseBoolToVisibility}}" />

                        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding LastAction}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LastAction}" />
                    </Grid>
                </Border>

                <!-- The next few players (the rest of the queue stays hidden), and the whole queue on demand, sorted by name -->
                <Grid Grid.Column="3" Width="300" Margin="12,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Margin="0,0,0,8" Padding="18,14" Style="{StaticResource Card}" Visibility="{Binding ShowsUpNext, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelLabel}" Text="{Binding UpNextHeader}" />
                            <Grid>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Nobody else in the queue."
                                           Visibility="{Binding UpNext.Count, Converter={StaticResource EmptyToVisibility}}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding UpNext}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="1" Rows="{Binding DataContext.UpNextRows, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                            <Grid MinHeight="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="18" Style="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="24" ItemsSource="{Binding Classes}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="RemainingButton_Click"
                            ToolTip="Everyone still in the queue, sorted by name so the auction order stays hidden (skipped players not included)">
                        <controls:IconLabel Glyph="&#xE8FD;" Text="{Binding RemainingCount, StringFormat='Remaining players ({0})'}" />
                    </Button>
                </Grid>
            </Grid>

            <!-- Rosters: every team, always fully visible -->
            <controls:ScaleToFit Grid.Row="2" VerticalAlignment="Top" MaxScale="1.25" MinScale="0.5">
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource TeamCardTemplate}" ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FitGrid MinItemWidth="260" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </controls:ScaleToFit>
        </Grid>
    </Grid>
</UserControl>
