<UserControl x:Class="AuctionApp.Views.AuctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AuctionViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1900"
             mc:Ignorable="d">
    <!--
        Designed to be screen-shared: everything viewers need is on screen at once (the player on the block, the next
        few players, every team with its budget and roster), with no scrolling and nothing they shouldn't see.
        The auction itself (player on the block, bid controls, next players) is the top band; the rosters fill the rest.
    -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <DataTemplate x:Key="TeamCardTemplate" DataType="{x:Type vm:TeamCardViewModel}">
            <Border x:Name="Card"
                    Padding="14,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TeamName" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Strong}" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding RemainingText}" />
                    </Grid>
                    <ProgressBar DockPanel.Dock="Top" Height="4" Margin="0,4,0,4" Maximum="1" Minimum="0" Value="{Binding BudgetLeftRatio, Mode=OneWay}" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock x:Name="MaxBid" FontSize="13" Style="{StaticResource Caption}" Text="{Binding MaxBidText}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="13" Style="{StaticResource Caption}" Text="{Binding SlotsText}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="12" Style="{StaticResource Caption}" Text="{Binding CompositionText}" />

                    <StackPanel>
                        <ItemsControl Focusable="False" ItemsSource="{Binding Picks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PickItemViewModel}">
                                    <Grid x:Name="Row" Height="27" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource Body}" Text="{Binding Name}" />
                                        <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="20" ItemsSource="{Binding Classes}" />
                                        <TextBlock Grid.Column="2" MinWidth="36" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PriceText}" TextAlignment="Right" />
                                        <Button x:Name="ReturnButton" Grid.Column="3" Margin="2,0,0,0" Padding="4" Command="{Binding ReturnCommand}"
                                                IsEnabled="{Binding CanReturn}" Style="{StaticResource SubtleButton}"
                                                ToolTip="Take back (refund and put on the block again)" Visibility="Collapsed">
                                            <TextBlock FontSize="12" Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ReturnButton" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Focusable="False" ItemsSource="{Binding EmptySlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="21" Margin="0,3" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanBuy}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Padding" Value="13,11" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="TeamName" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,16">
        <!-- Before the auction starts -->
        <Border MaxWidth="560" Margin="0,48,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE768;" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="The auction hasn't started yet" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="Set up the captains on the Configure page, then click Start auction at the bottom of it." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top: the auction itself. The player on the block, the bid, the next players. -->
            <Border Padding="24,16" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="470" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- On the block -->
                    <Grid VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PanelLabel}" Text="NOW ON THE BLOCK" />
                            <Viewbox HorizontalAlignment="Left" MaxHeight="76" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock FontSize="60" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CurrentPlayerName}" />
                            </Viewbox>
                            <controls:ClassIconStrip Margin="0,10,0,0" HorizontalAlignment="Left" IconSize="44" ItemsSource="{Binding CurrentPlayerClasses}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PanelLabel}" Text="QUEUE EMPTY" />
                            <TextBlock FontSize="22" Style="{StaticResource SectionTitle}" Text="{Binding QueueEmptyText}" TextWrapping="Wrap" />
                            <Button Margin="0,12,0,0" Command="{Binding RequeueSkippedCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                                <controls:IconLabel Glyph="&#xE72C;" Text="Auction the skipped players again" />
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PanelLabel}" Text="ALL DONE" />
                            <TextBlock FontSize="22" Style="{StaticResource SectionTitle}" Text="The auction is finished." />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Command="{Binding ShowTeamsCommand}" Style="{DynamicResource AccentButtonStyle}">
                                    <controls:IconLabel Glyph="&#xE902;" Text="Team compositions" />
                                </Button>
                                <Button Command="{Binding ReopenCommand}" ToolTip="Continue the auction; unsold players go back to the skipped list">
                                    <controls:IconLabel Glyph="&#xE72C;" Text="Reopen" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- The auctioneer's controls -->
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" Click="SkippedButton_Click" IsEnabled="{Binding IsRunning}"
                                        ToolTip="See every skipped player and put one back on the block">
                                    <controls:IconLabel Glyph="&#xE8FD;" Text="{Binding SkippedCount, StringFormat='Skipped players ({0})'}" />
                                </Button>
                                <Button Grid.Column="2" MinWidth="90" Command="{Binding UndoCommand}" ToolTip="{Binding UndoText}">
                                    <controls:IconLabel Glyph="&#xE7A7;" Text="Undo" />
                                </Button>
                                <Button Grid.Column="4" MinWidth="90" Command="{Binding FinishCommand}" IsEnabled="{Binding IsRunning}">
                                    <controls:IconLabel Glyph="&#xE7C1;" Text="Finish" />
                                </Button>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <CheckBox VerticalAlignment="Center" Content="Half budget cap" IsChecked="{Binding HalfBudgetCap}" IsEnabled="{Binding IsRunning}"
                                          ToolTip="While on, captains can only spend down to half of their starting budget; the other half stays reserved." />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Sold " /><Run FontWeight="SemiBold" Text="{Binding SoldCount, Mode=OneWay}" />
                                    <Run Text=" · Remaining " /><Run FontWeight="SemiBold" Text="{Binding RemainingCount, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Top" Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Teams}"
                                          SelectedItem="{Binding SelectedTeam}" ToolTip="Winning team (you can also click a team card)" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Winning team: pick it here or click its card"
                                           Visibility="{Binding SelectedTeam, Converter={StaticResource EmptyToVisibility}}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Width="40" Height="46" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" Content="−" FontSize="18" ToolTip="−0.1 (Down arrow)" />
                                <TextBox x:Name="PriceBox" Grid.Column="1" Margin="4,0" VerticalContentAlignment="Center" FontSize="24" FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Price in millions. Enter sells, Up/Down change it by 0.1.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SellCommand}" />
                                        <KeyBinding Key="Up" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" />
                                        <KeyBinding Key="Down" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <RepeatButton Grid.Column="2" Width="40" Height="46" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" Content="+" FontSize="18" ToolTip="+0.1 (Up arrow)" />
                                <Button Grid.Column="4" Height="46" HorizontalAlignment="Stretch" Command="{Binding SellCommand}" Style="{DynamicResource AccentButtonStyle}"
                                        ToolTip="Sell to the selected team (Enter)">
                                    <controls:IconLabel Glyph="&#xE8FB;" Text="Sold!" />
                                </Button>
                                <Button Grid.Column="6" Height="46" MinWidth="84" Command="{Binding SkipCommand}" ToolTip="Nobody bids: move to the skipped list">
                                    <controls:IconLabel Glyph="&#xE893;" Text="Skip" />
                                </Button>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding SaleProblem}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SaleProblem}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- The next few players: the rest of the queue stays hidden -->
                    <Border Grid.Column="4" Padding="16,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelLabel}" Text="{Binding UpNextHeader}" Visibility="{Binding ShowsUpNext, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Nobody else in the queue."
                                       Visibility="{Binding UpNext.Count, Converter={StaticResource EmptyToVisibility}}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding UpNext}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="17" Style="{StaticResource Body}" Text="{Binding Name}" />
                                            <controls:ClassIconStrip Grid.Column="1" IconSize="24" ItemsSource="{Binding Classes}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding LastAction}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" ToolTip="{Binding LastAction}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Rosters: every team, always fully visible -->
            <controls:ScaleToFit Grid.Row="2" VerticalAlignment="Top" MaxScale="1.25" MinScale="0.5">
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource TeamCardTemplate}" ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FitGrid MinItemWidth="260" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </controls:ScaleToFit>
        </Grid>
    </Grid>
</UserControl>
