<UserControl x:Class="AuctionApp.Views.AuctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AuctionViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Strong}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <DataTemplate x:Key="TeamCardTemplate" DataType="{x:Type vm:TeamCardViewModel}">
            <Border x:Name="Card"
                    Padding="14,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TeamName" VerticalAlignment="Center" FontSize="16" Style="{StaticResource Strong}" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource StatValue}" Text="{Binding RemainingText}"
                                   ToolTip="Budget left" />
                    </Grid>
                    <ProgressBar Height="4" Margin="0,6,0,4" Maximum="1" Minimum="0" Value="{Binding BudgetLeftRatio, Mode=OneWay}" />
                    <Grid>
                        <TextBlock x:Name="MaxBid" Style="{StaticResource Caption}" Text="{Binding MaxBidText}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}" Text="{Binding SlotsText}" ToolTip="Players bought / team size" />
                    </Grid>

                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding Picks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PickItemViewModel}">
                                <Grid x:Name="Row" Height="23" Background="Transparent" ToolTip="{Binding Details}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding Name}" />
                                    <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="14" ItemsSource="{Binding Classes}" />
                                    <TextBlock Grid.Column="2" MinWidth="34" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PriceText}" TextAlignment="Right" />
                                    <Button x:Name="ReturnButton" Grid.Column="3" Margin="2,0,0,0" Padding="4" Command="{Binding ReturnCommand}"
                                            IsEnabled="{Binding CanReturn}" Style="{StaticResource SubtleButton}" ToolTip="Take back (refund and put on the block again)" Visibility="Hidden">
                                        <TextBlock FontSize="12" Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ReturnButton" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Focusable="False" ItemsSource="{Binding EmptySlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="19" Margin="0,2" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding CompositionText}"
                               Visibility="{Binding CompositionText, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanBuy}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Padding" Value="13,11" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="TeamName" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,16,32,8">
        <!-- Before the auction starts -->
        <Border MaxWidth="560" Margin="0,48,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE768;" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="The auction hasn't started yet" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="Set up the captains on the Configure page, then click Start auction at the bottom of it." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,24,0" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Strong}" Text="{Binding Title}" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Sold " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SoldCount, Mode=OneWay}" />
                        <Run Text="   ·   Remaining " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding RemainingCount, Mode=OneWay}" />
                        <Run Text="   ·   Skipped " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SkippedCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <CheckBox Margin="0,0,16,0" Content="Half budget cap" IsChecked="{Binding HalfBudgetCap}" IsEnabled="{Binding IsRunning}"
                              ToolTip="While on, captains can only spend down to half of their starting budget; the other half stays reserved." />
                    <Button Command="{Binding UndoCommand}" ToolTip="{Binding UndoText}">
                        <controls:IconLabel Glyph="&#xE7A7;" Text="Undo" />
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding FinishCommand}" IsEnabled="{Binding IsRunning}">
                        <controls:IconLabel Glyph="&#xE7C1;" Text="Finish" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- On the block -->
            <Border Grid.Row="1" Margin="0,0,12,12" Padding="24,16" Style="{StaticResource Card}">
                <Grid>
                    <!-- A player is up for auction -->
                    <Grid Visibility="{Binding HasCurrentPlayer, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Overline}" Text="NOW ON THE BLOCK" />
                            <Viewbox Margin="0,4,0,0" HorizontalAlignment="Left" MaxHeight="72" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock FontSize="56" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CurrentPlayerName}" />
                            </Viewbox>
                            <controls:ClassIconStrip Margin="0,12,0,0" HorizontalAlignment="Left" IconSize="40" ItemsSource="{Binding CurrentPlayerClasses}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="440" Margin="24,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Teams}"
                                          SelectedItem="{Binding SelectedTeam}" ToolTip="Winning team (you can also click a team card below)" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Winning team: pick it here or click its card"
                                           Visibility="{Binding SelectedTeam, Converter={StaticResource EmptyToVisibility}}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Width="40" Height="44" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" Content="−" FontSize="18" ToolTip="−0.1 (Down arrow)" />
                                <TextBox x:Name="PriceBox" Grid.Column="1" Margin="6,0" VerticalContentAlignment="Center" FontSize="22" FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Price in millions. Enter sells, Up/Down change it by 0.1.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SellCommand}" />
                                        <KeyBinding Key="Up" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" />
                                        <KeyBinding Key="Down" Command="{Binding ChangePriceCommand}" CommandParameter="-0.1" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <RepeatButton Grid.Column="2" Width="40" Height="44" Command="{Binding ChangePriceCommand}" CommandParameter="0.1" Content="+" FontSize="18" ToolTip="+0.1 (Up arrow)" />
                                <StackPanel Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button MinWidth="48" Command="{Binding ChangePriceCommand}" CommandParameter="0.5" Content="+0.5" />
                                    <Button MinWidth="40" Margin="4,0,0,0" Command="{Binding ChangePriceCommand}" CommandParameter="1" Content="+1" />
                                    <Button MinWidth="48" Margin="4,0,0,0" Command="{Binding MaxPriceCommand}" Content="Max" ToolTip="The most the selected team can pay" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Height="36" Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding SaleProblem}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding SaleProblem}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Height="44" HorizontalAlignment="Stretch" Command="{Binding SellCommand}" Style="{DynamicResource AccentButtonStyle}"
                                        ToolTip="Sell to the selected team (Enter)">
                                    <controls:IconLabel Glyph="&#xE8FB;" Text="Sold!" />
                                </Button>
                                <Button Grid.Column="2" Height="44" MinWidth="110" Command="{Binding SkipCommand}" ToolTip="Nobody bids: move to the skipped list">
                                    <controls:IconLabel Glyph="&#xE893;" Text="Skip" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Nobody left in the queue -->
                    <StackPanel Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Overline}" Text="QUEUE EMPTY" />
                        <TextBlock Margin="0,4,0,0" FontSize="24" Style="{StaticResource SectionTitle}" Text="{Binding QueueEmptyText}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding RequeueSkippedCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                                <controls:IconLabel Glyph="&#xE72C;" Text="Auction the skipped players again" />
                            </Button>
                            <Button Command="{Binding FinishCommand}">
                                <controls:IconLabel Glyph="&#xE7C1;" Text="Finish the auction" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Finished -->
                    <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Overline}" Text="ALL DONE" />
                        <TextBlock Margin="0,4,0,0" FontSize="24" Style="{StaticResource SectionTitle}" Text="The auction is finished." />
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding ShowTeamsCommand}" Style="{DynamicResource AccentButtonStyle}">
                                <controls:IconLabel Glyph="&#xE902;" Text="See the team compositions" />
                            </Button>
                            <Button Command="{Binding ReopenCommand}" ToolTip="Continue the auction; unsold players go back to the skipped list">
                                <controls:IconLabel Glyph="&#xE72C;" Text="Reopen the auction" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Teams -->
            <ScrollViewer Grid.Row="2" Margin="0,0,12,0" Padding="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource TeamCardTemplate}" ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Picks the column count that fits every card on screen, whatever the number of teams and roster size. -->
                            <controls:FitGrid VerticalAlignment="Top" MinItemWidth="190" Spacing="12"
                                              FitHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Side panel: what's coming, what was skipped, what happened -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Players who joined the pool (or were released by another division) after this auction started -->
                <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="8"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding HasNewPlayers, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Strong}" TextWrapping="Wrap">
                            <Run Text="{Binding NewPlayersCount, Mode=OneWay}" /><Run Text=" new player(s) in the pool" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="Added to the pool, or released by another division, since this auction started." />
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddNewPlayersCommand}" Content="Add to the queue" Style="{DynamicResource AccentButtonStyle}" />
                            <Button Margin="8,0,0,0" Command="{Binding DismissNewPlayersCommand}" Content="Ignore" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,12" Style="{StaticResource Card}"
                        Visibility="{Binding ShowsUpNext, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}" Text="{Binding UpNextHeader}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="Nobody else in the queue."
                                   Visibility="{Binding UpNext.Count, Converter={StaticResource EmptyToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Focusable="False" ItemsSource="{Binding UpNext}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Position}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding Name}" />
                                            <controls:ClassIconStrip Grid.Column="2" IconSize="14" ItemsSource="{Binding Classes}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,0,0,12" Padding="16,12" Style="{StaticResource Card}"
                        Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource PanelTitle}">
                                <Run Text="Skipped (" /><Run Text="{Binding SkippedCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <Button Margin="0,-4,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RequeueSkippedCommand}"
                                    IsEnabled="{Binding IsRunning}" Style="{StaticResource SubtleButton}" ToolTip="Send everyone back to the end of the queue">
                                <controls:IconLabel Glyph="&#xE72C;" Text="Requeue all" />
                            </Button>
                        </Grid>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="0,0,14,0" Focusable="False" ItemsSource="{Binding Skipped}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding Name}" />
                                            <controls:ClassIconStrip Grid.Column="1" IconSize="14" ItemsSource="{Binding Classes}" />
                                            <Button Grid.Column="2" Margin="4,0,0,0" Padding="4"
                                                    Command="{Binding DataContext.BringBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource SubtleButton}" ToolTip="Put back on the block now">
                                                <TextBlock FontSize="12" Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Margin="0,0,0,12" Padding="16,12" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}" Text="Activity" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="0,0,14,0" Focusable="False" ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ActivityItemViewModel}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Time}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Style="{StaticResource Glyph}" Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
