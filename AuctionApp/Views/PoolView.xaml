<UserControl x:Class="AuctionApp.Views.PoolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PoolViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1600"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             IsTabStop="False"
             mc:Ignorable="d">
    <UserControl.Resources>
        <controls:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource ClassToggle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <!-- A centered column, like a document: the list doesn't need the full width of the window. -->
    <Grid MaxWidth="1180" Margin="24,20,24,20" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Finding players -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Grid Width="280">
                    <TextBox Padding="32,5,10,6" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource Glyph}" Text="&#xE721;" />
                    <TextBlock Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Search players"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>

                <StackPanel Margin="14,0,0,0" Orientation="Horizontal" ToolTip="Show only players with these classes">
                    <ToggleButton IsChecked="{Binding FilterInfantry}" Style="{StaticResource FilterToggle}" Tag="inf" />
                    <ToggleButton IsChecked="{Binding FilterArcher}" Style="{StaticResource FilterToggle}" Tag="arc" />
                    <ToggleButton IsChecked="{Binding FilterCavalry}" Style="{StaticResource FilterToggle}" Tag="cav" />
                </StackPanel>

                <ListBox Margin="10,0,0,0" SelectedIndex="{Binding AvailabilityFilter}" Style="{StaticResource SegmentedList}">
                    <ListBoxItem ToolTip="Everyone">
                        <TextBlock Text="All" />
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Not bought yet">
                        <TextBlock Text="Available" />
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Already bought">
                        <TextBlock Text="Unavailable" />
                    </ListBoxItem>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <!-- Sorted by name unless the auction order is asked for, so the upcoming order isn't shown on stream by accident -->
                <ListBox Style="{StaticResource SegmentedList}" SelectedIndex="{Binding IsAuctionOrder, Converter={x:Static controls:BoolToIndexConverter.Instance}}">
                    <ListBoxItem ToolTip="Sorted by name">
                        <TextBlock Text="A–Z" />
                    </ListBoxItem>
                    <ListBoxItem ToolTip="The order divisions that don't shuffle auction the players in. Drag the handles or press Alt+↑/↓ to rearrange.">
                        <TextBlock Text="Auction order" />
                    </ListBoxItem>
                </ListBox>
                <Button Margin="4,0,0,0" Command="{Binding SortPoolOrderByNameCommand}" Style="{StaticResource SubtleButton}" ToolTip="Put the auction order in alphabetical order"
                        Visibility="{Binding IsAuctionOrder, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding RemovePlayersCommand}" CommandParameter="{Binding SelectedItems, ElementName=PlayersGrid}" Style="{StaticResource SubtleButton}"
                        ToolTip="Remove the selected players (Delete). Players already bought are taken off their team, which gets the money back.">
                    <controls:IconLabel Glyph="&#xE74D;" Text="Remove" />
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding ImportPlayersCommand}" Style="{StaticResource SubtleButton}"
                        ToolTip="Add players from a player list (CSV or JSON), e.g. a sign-up sheet">
                    <controls:IconLabel Glyph="&#xE8B5;" Text="Import…" />
                </Button>
                <Button x:Name="ExportButton" Margin="4,0,0,0" Click="ExportButton_Click" Style="{StaticResource SubtleButton}"
                        ToolTip="Save the player list (names and classes) as CSV or JSON">
                    <controls:IconLabel Glyph="&#xEDE1;" Text="Export…" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding ExportPlayersCommand}" CommandParameter="csv" Header="CSV (Excel)…" />
                            <MenuItem Command="{Binding ExportPlayersCommand}" CommandParameter="json" Header="JSON…" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="6" Style="{StaticResource Card}">
            <DockPanel>
                <!--
                    Column headers, then the row for adding a player, then the players. The grid's own headers are hidden
                    so the add row can sit between them; the widths follow the grid's columns.
                -->
                <Border DockPanel.Dock="Top" Height="34" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{Binding Columns[0].ActualWidth, ElementName=PlayersGrid}" Visibility="{Binding IsAuctionOrder, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Width="{Binding Columns[1].ActualWidth, ElementName=PlayersGrid}" Padding="6,0" VerticalAlignment="Center" Style="{StaticResource Overline}" Text="#"
                                   Visibility="{Binding IsAuctionOrder, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Width="{Binding Columns[2].ActualWidth, ElementName=PlayersGrid}" Padding="6,0" VerticalAlignment="Center" Style="{StaticResource Overline}" Text="NAME" />
                        <TextBlock Width="{Binding Columns[3].ActualWidth, ElementName=PlayersGrid}" VerticalAlignment="Center" Style="{StaticResource Overline}" Text="CLASSES" />
                        <TextBlock Padding="6,0" VerticalAlignment="Center" Style="{StaticResource Overline}" Text="STATUS" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="48" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{Binding Columns[0].ActualWidth, ElementName=PlayersGrid}" Visibility="{Binding IsAuctionOrder, Converter={StaticResource BoolToVisibility}}" />
                        <Border Width="{Binding Columns[1].ActualWidth, ElementName=PlayersGrid}" Visibility="{Binding IsAuctionOrder, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Width="{Binding Columns[2].ActualWidth, ElementName=PlayersGrid}" Margin="0,0,0,0">
                            <TextBox x:Name="NewPlayerBox" Margin="0,0,12,0" Padding="32,5,10,6" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Text="{Binding NewPlayerText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="A name, optionally followed by classes (Alice, inf cav), or tick the classes on the right. Enter adds the player.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddPlayerCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Style="{StaticResource Glyph}" Text="&#xE710;" />
                            <TextBlock Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Add a player"
                                       Visibility="{Binding NewPlayerText, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <StackPanel Width="{Binding Columns[3].ActualWidth, ElementName=PlayersGrid}" VerticalAlignment="Center" Orientation="Horizontal">
                            <ToggleButton Margin="0,0,4,0" IsChecked="{Binding NewInfantry}" Style="{StaticResource ClassToggle}" Tag="inf" />
                            <ToggleButton Margin="0,0,4,0" IsChecked="{Binding NewArcher}" Style="{StaticResource ClassToggle}" Tag="arc" />
                            <ToggleButton IsChecked="{Binding NewCavalry}" Style="{StaticResource ClassToggle}" Tag="cav" />
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Command="{Binding AddPlayerCommand}" Style="{DynamicResource AccentButtonStyle}" ToolTip="Add the player (Enter)">
                                <controls:IconLabel Glyph="&#xE710;" Text="Add" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="PlayersGrid"
                          AllowDrop="True"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          DragLeave="PlayersGrid_DragLeave"
                          DragOver="PlayersGrid_DragOver"
                          Drop="PlayersGrid_Drop"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="None"
                          IsKeyboardFocusWithinChanged="PlayersGrid_IsKeyboardFocusWithinChanged"
                          ItemsSource="{Binding PlayersView}"
                          PreviewKeyDown="PlayersGrid_PreviewKeyDown"
                          PreviewMouseLeftButtonUp="PlayersGrid_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="PlayersGrid_PreviewMouseMove"
                          RowHeight="44"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          Unloaded="PlayersGrid_Unloaded">
                    <DataGrid.Resources>
                        <!-- A light accent wash instead of the solid accent, so the class icons stay readable on the selected row -->
                        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Opacity="0.22" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
                        <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="{DynamicResource TextFillColorPrimary}" />
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34" CanUserResize="False"
                                                Visibility="{Binding Data.IsAuctionOrder, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown" ToolTip="Drag to move">
                                        <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Style="{StaticResource Glyph}" Text="&#xE76F;" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="48" Binding="{Binding Position}" ElementStyle="{StaticResource CellText}" Header="#" IsReadOnly="True"
                                            Visibility="{Binding Data.IsAuctionOrder, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}" />
                        <DataGridTextColumn Width="*" MinWidth="200" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" Header="NAME" />

                        <DataGridTemplateColumn Width="130" Header="CLASSES">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ToggleButton Margin="0,0,4,0" IsChecked="{Binding Infantry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ClassToggle}" Tag="inf" />
                                        <ToggleButton Margin="0,0,4,0" IsChecked="{Binding Archer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ClassToggle}" Tag="arc" />
                                        <ToggleButton IsChecked="{Binding Cavalry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ClassToggle}" Tag="cav" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="280" Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <TextBlock x:Name="Text" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Picked">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="InAuction">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- How many players, below the list -->
        <Grid Grid.Row="2" Margin="4,8,4,0">
            <TextBlock FontSize="12" Style="{StaticResource Caption}" Text="{Binding Summary}" />
            <TextBlock HorizontalAlignment="Right" FontSize="12" Style="{StaticResource Caption}" Text="{Binding ShownCount}" />
        </Grid>
    </Grid>
</UserControl>
