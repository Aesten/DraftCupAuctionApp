<Window x:Class="AuctionApp.Views.PickBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AuctionApp.Controls"
        xmlns:vm="clr-namespace:AuctionApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:AuctionViewModel}"
        Width="1400"
        Height="800"
        MinWidth="700"
        MinHeight="400"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
    <!--
        Captain Pick: every player still available, one card per tier with a column per class, like the spreadsheet it
        replaces. Picked players leave the board. Clicking a name puts that player on the block. It can be moved to
        another screen or shared on stream; everything stays visible without scrolling.
    -->
    <Window.Resources>
        <DataTemplate x:Key="BoardPlayer" DataType="{x:Type vm:BoardPlayerViewModel}">
            <Border x:Name="Row" Height="28" Margin="0,1" Padding="6,0" Background="Transparent" CornerRadius="4" Cursor="Hand"
                    ToolTip="{Binding Name, StringFormat='Put {0} on the block'}">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding PickCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
                <TextBlock x:Name="Name" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsOnBlock}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Row" Property="ToolTip" Value="On the block" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One class of a tier: the class icon and how many are left, then the names -->
        <DataTemplate x:Key="BoardColumn" DataType="{x:Type vm:BoardColumnViewModel}">
            <DockPanel MinWidth="64" Margin="3,0">
                <Border DockPanel.Dock="Top" Height="32" Margin="0,0,0,6" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel x:Name="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <Rectangle x:Name="Icon" Width="20" Height="20" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                   ToolTip="{Binding Code, Converter={StaticResource ClassName}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Code, Converter={StaticResource ClassIcon}}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Count}" />
                    </StackPanel>
                </Border>
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource BoardPlayer}" ItemsSource="{Binding Players}" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Code}" Value="">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Count}" Value="0">
                    <Setter TargetName="Header" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BoardTier" DataType="{x:Type vm:BoardTierViewModel}">
            <Border Margin="6" Padding="10,12" VerticalAlignment="Stretch" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding MinimumText}" ToolTip="Minimum bid" />
                    </Grid>
                    <ItemsControl Focusable="False" ItemTemplate="{StaticResource BoardColumn}" ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="6,0,6,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="20" Style="{StaticResource Strong}" Text="Pick board" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Style="{StaticResource Caption}"
                           Text="{Binding BoardCount, StringFormat='{}{0} players left  ·  click the player a captain picks to put them on the block'}" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" Text="F11: full screen" />
        </Grid>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Style="{StaticResource SectionTitle}"
                   Text="The auction is finished." Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />

        <!--
            Every tier side by side, each as wide as its longest names, and the whole board scaled to fit the window
            (never scrolled, never cut).
        -->
        <controls:ScaleToFit Grid.Row="1" VerticalAlignment="Top" FitWidth="True" MaxScale="1.4" MinScale="0.3">
            <ItemsControl Focusable="False" ItemTemplate="{StaticResource BoardTier}" ItemsSource="{Binding Board}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </controls:ScaleToFit>
    </Grid>
</Window>
