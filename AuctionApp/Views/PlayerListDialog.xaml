<Window x:Class="AuctionApp.Views.PlayerListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AuctionApp.Controls"
        xmlns:vm="clr-namespace:AuctionApp.ViewModels"
        Width="460"
        Height="600"
        MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- A read-only list of players, e.g. the rest of the queue during an auction. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="CaptionText" Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Margin="12,8" Style="{StaticResource Caption}" Text="Nobody." Visibility="Collapsed" />
                <ItemsControl x:Name="PlayersList" Margin="0,0,12,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                            <Grid Height="36" Margin="12,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <controls:ClassIconStrip Grid.Column="1" Margin="8,0,0,0" IconSize="22" ItemsSource="{Binding Classes}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,16"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Button MinWidth="96" HorizontalAlignment="Right" Content="Close" IsCancel="True" IsDefault="True" />
        </Border>
    </Grid>
</Window>
