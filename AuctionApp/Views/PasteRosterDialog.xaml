<Window x:Class="AuctionApp.Views.PasteRosterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add players to the pool"
        Width="620"
        Height="560"
        MinWidth="480"
        MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,12">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Add players to the pool" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                Paste one player per line, straight from a spreadsheet, a sign-up form or a chat message.
                Classes can follow the name, e.g. <Run FontWeight="SemiBold" Text="Alice, inf cav" />.
                Rows copied from a spreadsheet with INF / ARC / CAV columns marked with an x work too.
            </TextBlock>
        </StackPanel>

        <TextBox x:Name="Input"
                 Grid.Row="1"
                 Margin="24,0"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Cascadia Mono, Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 TextChanged="Input_TextChanged"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="Summary" Grid.Row="2" Margin="24,12" Style="{StaticResource Caption}" Text="No players yet" />

        <Border Grid.Row="3"
                Padding="24,16"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="AddButton" MinWidth="120" Click="Add_Click" Content="Add players" IsDefault="False" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Margin="8,0,0,0" MinWidth="96" Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
