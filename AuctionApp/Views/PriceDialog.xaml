<Window x:Class="AuctionApp.Views.PriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap" />
            <TextBox x:Name="PriceBox" Margin="0,16,0,0" HorizontalContentAlignment="Center" FontSize="24" FontWeight="SemiBold" PreviewKeyDown="PriceBox_PreviewKeyDown" TextChanged="PriceBox_TextChanged" />
            <TextBlock x:Name="ProblemText" Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="24,16"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" MinWidth="96" Click="Ok_Click" Content="Change price" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
                <Button MinWidth="96" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
