<UserControl x:Class="AuctionApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             mc:Ignorable="d">
    <Grid Margin="40,32,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Draft Cup Auction" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="14"
                           Text="Pick a draft to continue, or start a new one. Everything is saved automatically." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Command="{Binding ImportCommand}"
                        ToolTip="Import a backup, or a .json file from the previous version of the app (auction plan or auction state)">
                    <controls:IconLabel Glyph="&#xE8B5;" Text="Import…" />
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding NewDraftCommand}" Style="{DynamicResource AccentButtonStyle}">
                    <controls:IconLabel Glyph="&#xE710;" Text="New draft" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Draft list -->
        <ScrollViewer Grid.Row="1" Padding="0,0,0,32" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Drafts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DraftCardViewModel}">
                            <Border Margin="0,0,0,8" Cursor="Hand" Style="{StaticResource Card}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"
                                                  MouseAction="LeftDoubleClick" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" Margin="0,0,16,0" CornerRadius="8"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                   Style="{StaticResource Glyph}" Text="&#xE7FC;" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="16" Style="{StaticResource Strong}" Text="{Binding Title}" />
                                            <Border Margin="12,0,0,0" x:Name="StatusPill" Style="{StaticResource Pill}">
                                                <TextBlock x:Name="StatusText" FontSize="12" Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                                            <Run Text="{Binding Details, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SubtleButton}"
                                                ToolTip="Export a backup file (to share it or move it to another PC)">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDE1;" />
                                        </Button>
                                        <Button Margin="4,0,0,0"
                                                Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SubtleButton}"
                                                ToolTip="Duplicate: same captains, players and stages, without the auction">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                                        </Button>
                                        <Button Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="Delete">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                                        </Button>
                                        <Button Margin="12,0,0,0" MinWidth="88"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Open" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                    <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Finished">
                                    <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <Border Padding="32" Style="{StaticResource Card}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Style="{StaticResource Glyph}" Text="&#xE7FC;" />
                        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="No drafts yet" />
                        <TextBlock Margin="0,8,0,0" MaxWidth="460" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource Caption}" FontSize="14"
                                   Text="Create a draft to enter your captains and players, then run the auction from the same place. Coming from the old version? Import your .json files." />
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Command="{Binding ImportCommand}" Content="Import a file…" />
                            <Button Margin="8,0,0,0" Command="{Binding NewDraftCommand}" Content="Create a draft" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Margin="0,16,0,0" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SubtleButton}"
                        ToolTip="{Binding DataFolder}">
                    <controls:IconLabel Glyph="&#xE8B7;" Text="Open the data folder" />
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
