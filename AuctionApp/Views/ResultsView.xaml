<UserControl x:Class="AuctionApp.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1600"
             mc:Ignorable="d">
    <Grid Margin="16,12,16,16">
        <Border MaxWidth="560" Margin="0,48,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE902;" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="No teams yet" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="The teams show up here once this division's auction has started." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Headline}" />
                    <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}" Style="{StaticResource Caption}" Text="{Binding CopyConfirmation}"
                               Visibility="{Binding CopyConfirmation, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CopyTextCommand}" Style="{DynamicResource AccentButtonStyle}" ToolTip="Copy the teams as text, formatted for Discord">
                        <controls:IconLabel Glyph="&#xE8C8;" Text="Copy as text" />
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" ToolTip="Every sale in a spreadsheet (CSV, opens in Excel)">
                        <controls:IconLabel Glyph="&#xE9F9;" Text="Export spreadsheet…" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Every team, always fully visible -->
            <controls:ScaleToFit Grid.Row="1" VerticalAlignment="Top" MaxScale="1.4" MinScale="0.5">
                <ItemsControl Focusable="False" ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FitGrid MinItemWidth="250" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TeamResultViewModel}">
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ClassIconStrip Margin="0,0,5,0" IconSize="22" ItemsSource="{Binding CaptainClasses}" />
                                        <TextBlock Grid.Column="1" FontSize="18" Style="{StaticResource Strong}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Style="{StaticResource Caption}" Text="{Binding SlotsText}" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,2,0,8" FontSize="13" Style="{StaticResource Caption}" Text="{Binding SpentText}" />
                                    <ItemsControl DockPanel.Dock="Bottom" Margin="0,8,0,0" ItemsSource="{Binding Composition}" Style="{StaticResource ClassCounts}" />
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Picks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultPickViewModel}">
                                                <Grid Height="27">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource Body}" Text="{Binding Name}" />
                                                    <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="20" ItemsSource="{Binding Classes}" />
                                                    <TextBlock Grid.Column="2" MinWidth="36" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PriceText}" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:ScaleToFit>

            <!-- Unsold players, beside the teams -->
            <Border Grid.Row="1" Grid.Column="1" Width="240" Margin="12,0,0,0" Padding="16,12" VerticalAlignment="Stretch" Style="{StaticResource Card}"
                    Visibility="{Binding HasUnsold, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource Strong}" Text="{Binding Unsold.Count, StringFormat='Not sold ({0})'}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="0,0,8,0" Focusable="False" ItemsSource="{Binding Unsold}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                    <Grid Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding Name}" />
                                        <controls:ClassIconStrip Grid.Column="1" IconSize="18" ItemsSource="{Binding Classes}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
