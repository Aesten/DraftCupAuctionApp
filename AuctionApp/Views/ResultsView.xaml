<UserControl x:Class="AuctionApp.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid Margin="32,16,32,8">
        <Border MaxWidth="560" Margin="0,48,0,0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE9D2;" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="No results yet" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="The teams show up here once this division's auction has started." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Headline}" />
                    <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}" Style="{StaticResource Caption}" Text="{Binding CopyConfirmation}"
                               Visibility="{Binding CopyConfirmation, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CopyTextCommand}" Style="{DynamicResource AccentButtonStyle}" ToolTip="Copy the teams as text, formatted for Discord">
                        <controls:IconLabel Glyph="&#xE8C8;" Text="Copy as text" />
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" ToolTip="Every sale in a spreadsheet (CSV, opens in Excel)">
                        <controls:IconLabel Glyph="&#xE9F9;" Text="Export spreadsheet…" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl Focusable="False" ItemsSource="{Binding Teams}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FitGrid VerticalAlignment="Top" MinItemWidth="220" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TeamResultViewModel}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontSize="16" Style="{StaticResource Strong}" Text="{Binding Name}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}" Text="{Binding SlotsText}" />
                                        </Grid>
                                        <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="{Binding SpentText}" />
                                        <ItemsControl Focusable="False" ItemsSource="{Binding Picks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ResultPickViewModel}">
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding Name}" />
                                                        <controls:ClassIconStrip Grid.Column="1" Margin="6,0,0,0" IconSize="14" ItemsSource="{Binding Classes}" />
                                                        <TextBlock Grid.Column="2" MinWidth="34" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PriceText}" TextAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding CompositionText}"
                                                   Visibility="{Binding CompositionText, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,12,0,12" Style="{StaticResource Card}" Visibility="{Binding HasUnsold, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Not sold" />
                            <ItemsControl Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Unsold}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerItemViewModel}">
                                        <Border Margin="0,0,8,8" Padding="10,4" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                                                <controls:ClassIconStrip Margin="6,0,0,0" IconSize="12" ItemsSource="{Binding Classes}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
