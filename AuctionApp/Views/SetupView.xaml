<UserControl x:Class="AuctionApp.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AuctionApp.Controls"
             xmlns:engine="clr-namespace:AuctionApp.Core.Engine;assembly=AuctionApp.Core"
             xmlns:vm="clr-namespace:AuctionApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <UserControl.Resources>
        <controls:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <!-- Red border for text boxes holding something that isn't a valid number. -->
        <Style x:Key="ErrorBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ClassHeader">
            <Rectangle Width="16" Height="16" Fill="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Converter={StaticResource ClassName}}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{Binding Converter={StaticResource ClassIcon}}" Stretch="Uniform" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,16,8,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Shown once the auction has started -->
        <Border Margin="0,0,0,16" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource Glyph}" Text="&#xE72E;" />
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Style="{StaticResource Strong}" Text="The auction has started, so the setup is locked." />
                    <TextBlock Style="{StaticResource Caption}" Text="To change captains, players or stages, reset the auction. That clears every sale." />
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ResetAuctionCommand}">
                    <controls:IconLabel Glyph="&#xE72C;" Text="Reset auction…" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel IsEnabled="{Binding IsEditable}">

                    <!-- General -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="General" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Team size" ToolTip="Players each captain buys, not counting the captain" />
                                    <ComboBox ToolTip="Players each captain buys, not counting the captain" HorizontalAlignment="Stretch" ItemsSource="{Binding TeamSizeOptions}" SelectedItem="{Binding TeamSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Budget for new captains" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource ErrorBorder}" Tag="{Binding HasDefaultBudgetError}">
                                            <TextBox Text="{Binding DefaultBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Border>
                                        <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding ApplyBudgetToAllCommand}" Style="{StaticResource SubtleButton}"
                                                ToolTip="Give every captain this budget">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C9;" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <CheckBox Margin="0,16,0,0" Content="Shuffle the players of each stage" IsChecked="{Binding ShuffleOrder}" />
                            <TextBlock Margin="28,0,0,0" Style="{StaticResource Caption}" Text="When off, players come up in the order of the list below." />
                        </StackPanel>
                    </Border>

                    <!-- Captains -->
                    <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding CaptainsHeader}" />
                                <Button HorizontalAlignment="Right" Command="{Binding AddCaptainCommand}">
                                    <controls:IconLabel Glyph="&#xE710;" Text="Add captain" />
                                </Button>
                            </Grid>
                            <TextBlock Margin="0,4,0,8" Style="{StaticResource Caption}" Text="Each captain leads a team and buys players with their budget (in millions)." />
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Caption}" Text="Name" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Caption}" Text="Budget" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Captains}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CaptainRowViewModel}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Loaded="CaptainName_Loaded" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ErrorBorder}" Tag="{Binding HasBudgetError}">
                                                <TextBox HorizontalContentAlignment="Right" Text="{Binding BudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                            </Border>
                                            <Button Grid.Column="2" Margin="4,0,0,0"
                                                    Command="{Binding Data.RemoveCaptainCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    ToolTip="Remove this captain">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Stages -->
                    <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Stages" />
                                <Button HorizontalAlignment="Right" Command="{Binding AddStageCommand}">
                                    <controls:IconLabel Glyph="&#xE710;" Text="Add stage" />
                                </Button>
                            </Grid>
                            <TextBlock Margin="0,4,0,8" Style="{StaticResource Caption}"
                                       Text="Auctions run one after the other, e.g. a high tier and then a low tier. Teams and budgets carry over, and players left unsold can be moved into the next stage." />
                            <Grid Margin="0,4,0,4" Visibility="{Binding HasMultipleStages, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Name" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Caption}" Text="Max buys" ToolTip="Most players a team may buy during this stage. Leave empty for no limit." />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Stages}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StageRowViewModel}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" HorizontalAlignment="Left" CornerRadius="11"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding Number}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="2,2,0,0" Style="{StaticResource Caption}" Text="{Binding PlayerCountText}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Style="{StaticResource ErrorBorder}" Tag="{Binding HasMaxPicksError}"
                                                    ToolTip="Most players a team may buy during this stage. Leave empty for no limit.">
                                                <TextBox HorizontalContentAlignment="Right" Text="{Binding MaxPicksText, UpdateSourceTrigger=PropertyChanged}" />
                                            </Border>
                                            <StackPanel Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                                                <Button Command="{Binding Data.MoveStageUpCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsFirst, Converter={x:Static controls:Negate.Instance}}"
                                                        Style="{StaticResource SubtleButton}" ToolTip="Run earlier">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" />
                                                </Button>
                                                <Button Command="{Binding Data.MoveStageDownCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsLast, Converter={x:Static controls:Negate.Instance}}"
                                                        Style="{StaticResource SubtleButton}" ToolTip="Run later">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" />
                                                </Button>
                                                <Button Command="{Binding Data.RemoveStageCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanRemove}"
                                                        Style="{StaticResource DangerButton}" ToolTip="Remove this stage">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Players -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding PlayersHeader}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                   Text="Type in the empty last row to add a player, or paste a whole list. Select rows and press Delete to remove them." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="32,5,10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource Glyph}" Text="&#xE721;" />
                            <TextBlock Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Search players"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding PastePlayersCommand}" IsEnabled="{Binding IsEditable}" ToolTip="Add many players at once from a spreadsheet, a form or a chat message">
                                <controls:IconLabel Glyph="&#xE77F;" Text="Paste a list…" />
                            </Button>
                            <Button Margin="8,0,0,0" Command="{Binding RemovePlayersCommand}" IsEnabled="{Binding IsEditable}" CommandParameter="{Binding SelectedItems, ElementName=PlayersGrid}">
                                <controls:IconLabel Glyph="&#xE74D;" Text="Remove selected" />
                            </Button>
                            <Button Margin="8,0,0,0" Command="{Binding ExportPlayersCommand}" Style="{StaticResource SubtleButton}" ToolTip="Export the list as a spreadsheet (CSV)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDE1;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="PlayersGrid"
                              Grid.Row="2"
                              IsKeyboardFocusWithinChanged="PlayersGrid_IsKeyboardFocusWithinChanged"
                              Unloaded="PlayersGrid_Unloaded"
                              AutoGenerateColumns="False"
                              CanUserAddRows="{Binding IsEditable}"
                              CanUserDeleteRows="{Binding IsEditable}"
                              IsReadOnly="{Binding IsLocked}"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding PlayersView}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Name}" Header="Player">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="4,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="64" Header="inf" HeaderTemplate="{StaticResource ClassHeader}" SortMemberPath="Infantry">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="Box" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Infantry, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Converter={x:Static controls:IsNewItemPlaceholderConverter.Instance}}" Value="True">
                                                <Setter TargetName="Box" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="64" Header="arc" HeaderTemplate="{StaticResource ClassHeader}" SortMemberPath="Archer">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="Box" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Archer, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Converter={x:Static controls:IsNewItemPlaceholderConverter.Instance}}" Value="True">
                                                <Setter TargetName="Box" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="64" Header="cav" HeaderTemplate="{StaticResource ClassHeader}" SortMemberPath="Cavalry">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="Box" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Cavalry, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Converter={x:Static controls:IsNewItemPlaceholderConverter.Instance}}" Value="True">
                                                <Setter TargetName="Box" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="200" Header="Stage" SortMemberPath="StageOrder"
                                                    Visibility="{Binding Data.HasMultipleStages, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="Box"
                                                  HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="Name"
                                                  ItemsSource="{Binding Data.Stages, Source={StaticResource Proxy}}"
                                                  SelectedValue="{Binding StageId, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id"
                                                  IsEnabled="{Binding Data.IsEditable, Source={StaticResource Proxy}}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Converter={x:Static controls:IsNewItemPlaceholderConverter.Instance}}" Value="True">
                                                <Setter TargetName="Box" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: what still needs fixing, and the way into the auction -->
        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}"
                Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Strong}" Text="{Binding Summary}" />
                    <ItemsControl Margin="0,4,0,0" Focusable="False" ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type engine:ValidationIssue}">
                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Foreground="{DynamicResource SystemFillColorCautionBrush}" Style="{StaticResource Glyph}" Text="&#xE7BA;" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="1" MinWidth="180" Padding="20,10" VerticalAlignment="Center"
                        Command="{Binding StartAuctionCommand}"
                        IsEnabled="{Binding CanStart}"
                        Style="{DynamicResource AccentButtonStyle}">
                    <controls:IconLabel Glyph="&#xE768;" Text="Start auction" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
